# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the provider you want to use.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Which LLM backend to use: ollama | openai | anthropic | watsonx
NLSQL_PROVIDER=ollama

# Database connection (SQLAlchemy URL).
# SQLite is the default and needs no server:
NLSQL_DATABASE_URL=sqlite:///data/chinook.db
# MySQL (see docker-compose.yml):
# NLSQL_DATABASE_URL=mysql+pymysql://root:chinook@127.0.0.1:3306/Chinook

# Max rows returned by any generated query (a LIMIT is injected if missing)
NLSQL_MAX_ROWS=200
# How many times the agent may rewrite its SQL after an error
NLSQL_MAX_REPAIRS=2


# --- Ollama: free, runs on your machine, no API key -------------------------
# Install from https://ollama.com then: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# --- OpenAI (or any OpenAI-compatible endpoint) -----------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic --------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- IBM watsonx.ai (the provider used by the original IBM lab) -------------
# Create a free account at https://cloud.ibm.com and a watsonx.ai project.
# WATSONX_API_KEY=...
# WATSONX_PROJECT_ID=...
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL=ibm/granite-4-h-small
